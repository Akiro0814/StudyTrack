<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="学迹" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="24sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="打开学迹，选择科目并记录成绩" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
    <ImageView android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginVertical="8dp" android:contentDescription="最近成绩趋势" android:scaleType="fitXY"/>
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="成绩默认保存在本机" android:textSize="11sp" android:maxLines="2"/>
</LinearLayout>
